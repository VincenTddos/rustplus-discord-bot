# ===== Discord =====
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
COMMAND_PREFIX=!

# ===== Rust+ Server =====
# Server IP / hostname
RUST_IP=
# app.port (default 28082, must be opened by server admin)
RUST_PORT=
# Your Steam ID (numeric)
RUST_PLAYER_ID=
# Your Rust+ pairing token (obtained via Rust+ pairing flow)
RUST_PLAYER_TOKEN=

# ===== Auto Stats =====
AUTO_STATS_ENABLED=false
AUTO_STATS_INTERVAL_MINUTES=10
AUTO_STATS_SEND_TO_DISCORD=true
AUTO_STATS_SEND_TO_GAME=true

# ===== Bot =====
BOT_NAME=RustPlusBot
